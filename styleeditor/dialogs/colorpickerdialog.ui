  <property name="styleSheet">
   <string notr="true">QWidget#ColorPickerDialog {
    border-width: 1px;
    border-style: solid;
    border-radius: 8px;
}

#ColorPickerDialog QLabel {
    background: transparent;
    font-size: 12px;
}

#ColorPickerDialog QLabel#titleLabel {
    font-size: 16px;
    font-weight: bold;
}

#ColorPickerDialog QFrame#separator {
    border: none;
}

#ColorPickerDialog QSlider#alphaSlider::groove:horizontal {
    height: 4px;
    border-radius: 2px;
}

#ColorPickerDialog QSlider#alphaSlider::sub-page:horizontal {
    border-radius: 2px;
}

#ColorPickerDialog QSlider#alphaSlider::handle:horizontal {
    width: 12px;
    margin: -5px 0;
    border-width: 1px;
    border-style: solid;
    border-radius: 7px;
}

#ColorPickerDialog animatedwidgets--LineEdit[colorPickerControl=&quot;true&quot;] {
    background: transparent;
    border: none;
    min-height: 30px;
    min-width: 0px;
    font-size: 12px;
    qproperty-borderVisible: true;
    qproperty-borderWidth: 1;
    qproperty-cornerRadius: 4;
    qproperty-contentPadding: 8;
}

#ColorPickerDialog animatedwidgets--ComboBox[colorPickerControl=&quot;true&quot;] {
    min-height: 30px;
    min-width: 0px;
    font-size: 12px;
    qproperty-borderVisible: true;
    qproperty-borderWidth: 1;
    qproperty-cornerRadius: 4;
    qproperty-contentPadding: 8;
}

#ColorPickerDialog animatedwidgets--FilledButton[colorPickerControl=&quot;true&quot;] {
    min-height: 28px;
    min-width: 0px;
    border: none;
    padding: 0px;
    font-size: 12px;
    qproperty-cornerRadius: 4;
    qproperty-contentHorizontalPadding: 12;
    qproperty-contentVerticalPadding: 0;
}

#ColorPickerDialog animatedwidgets--IconLineEdit#alphaValueEdit {
    border: none;
    padding: 0px;
    min-width: 0px;
    font-size: 12px;
    qproperty-borderVisible: true;
    qproperty-borderWidth: 1;
    qproperty-cornerRadius: 4;
    qproperty-contentPadding: 2;
    qproperty-iconHint: true;
}

#ColorPickerDialog animatedwidgets--HoverIconButton#btn_close {
    qproperty-animateContentColor: true;
    qproperty-iconHint: true;
    qproperty-cornerRadius: 2;
}</string>

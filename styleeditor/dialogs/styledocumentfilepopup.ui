  <property name="styleSheet">
   <string notr="true">QWidget#StyleDocumentFilePopup { background: #ffffff; border: 1px solid #e6eaf0; border-radius: 12px; }
QLabel { color: #657084; background: transparent; }
QLabel#titleLabel { color: #172033; font-size: 18px; font-weight: 700; }
QLabel#errorLabel { color: #c84343; }
QTreeView { color: #172033; background: #f5f7fb; border: 1px solid #e6eaf0; border-radius: 8px; outline: none; }
QTreeView::item { height: 32px; padding: 2px 6px; border: none; }
QTreeView::item:hover { background: #eef0ff; }
QTreeView::item:selected { color: #5b67f1; background: #e5e9ff; }
QHeaderView::section { color: #657084; background: #f5f7fb; border: none; border-bottom: 1px solid #e6eaf0; padding: 8px; }
QScrollBar:vertical { width: 8px; background: transparent; }
QScrollBar::handle:vertical { min-height: 24px; background: #c5ccda; border-radius: 4px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
animatedwidgets--FilledButton[editorControl="true"] {
    min-height: 36px; min-width: 72px;
    qproperty-backgroundNormal: #5b67f1; qproperty-backgroundHover: #6975fa;
    qproperty-contentNormal: #ffffff; qproperty-cornerRadius: 9; qproperty-animateContentColor: true;
}
animatedwidgets--OutlineButton[editorControl="true"] {
    min-height: 36px; min-width: 64px;
    qproperty-borderNormal: #d7dde8; qproperty-borderHover: #5b67f1;
    qproperty-contentNormal: #172033; qproperty-contentHover: #5b67f1;
    qproperty-cornerRadius: 9; qproperty-animateContentColor: true;
}
animatedwidgets--LineEdit[editorControl="true"] {
    min-height: 34px; qproperty-backgroundNormal: #f5f7fb;
    qproperty-borderNormal: #e6eaf0; qproperty-borderHover: #5b67f1; qproperty-borderFocus: #5b67f1;
    qproperty-textColor: #172033; qproperty-cornerRadius: 8; qproperty-contentPadding: 9;
}</string>

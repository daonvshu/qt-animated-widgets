     <item row="1" column="1"><widget class="aw::LineEdit" name="nameEdit"><property name="placeholderText"><string>Enter a style name</string></property><property name="editorControl" stdset="0"><bool>true</bool></property></widget></item>
    </layout>
   </item>
   <item><widget class="QLabel" name="hintLabel"><property name="text"><string>Choose a widget type and give this style a name.</string></property><property name="wordWrap"><bool>true</bool></property></widget></item>

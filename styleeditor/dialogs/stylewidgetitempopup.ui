    font-size: 12px;
}

#StyleWidgetItemPopup[editorControl=&quot;true&quot;] animatedwidgets--FilledButton[editorControl=&quot;true&quot;] {
    min-height: 36px;
    min-width: 72px;
    qproperty-cornerRadius: 9;
    qproperty-animateContentColor: true;
}

#StyleWidgetItemPopup[editorControl=&quot;true&quot;] animatedwidgets--OutlineButton[editorControl=&quot;true&quot;] {
    min-height: 36px;
    min-width: 72px;
    qproperty-cornerRadius: 9;
    qproperty-animateContentColor: true;
}

#StyleWidgetItemPopup[editorControl=&quot;true&quot;] animatedwidgets--LineEdit[editorControl=&quot;true&quot;],
#StyleWidgetItemPopup[editorControl=&quot;true&quot;] animatedwidgets--ComboBox[editorControl=&quot;true&quot;] {

  <property name="windowTitle">
   <string>Custom Widget Styles</string>
  </property>
  <property name="styleSheet">
   <string notr="true">QWidget#centralWidget { font-family: &quot;Segoe UI&quot;; font-size: 13px; }
QMainWindow, QWidget#centralWidget, QWidget#main, QWidget#workspace { background: #f5f7fb; }
QLabel { color: #172033; background: transparent; }
QLabel#sectionDescription, QLabel#sectionStatus { color: #7c879a; background: transparent; }
QLabel#muted { color: #7c879a; }
QFrame#sidebar { background: #ffffff; border-right: 1px solid #e6eaf0; }
QFrame#topbar { background: #ffffff; border-bottom: 1px solid #e6eaf0; }
QFrame#documentPanel, QFrame#inspector, QFrame#previewCard, QFrame#codeCard, QFrame#sectionCard {
    background: #ffffff; border: 1px solid #e6eaf0; border-radius: 16px;
}
QLabel#brandLogo { color: #ffffff; background: #6571ff; border-radius: 11px; font-size: 15px; font-weight: 800; }
QLabel#brandName { color: #172033; font-size: 16px; font-weight: 750; }
QLabel#brandSubtitle, QLabel#pageDescription, QLabel#documentPathLabel, QLabel#documentHintLabel { color: #7c879a; font-size: 11px; }
QLabel#navigationLabel, QLabel#resourceLabel { padding: 15px 10px 8px; color: #7c879a; font-size: 11px; letter-spacing: 1px; }
QLabel#pageTitle, QLabel#sectionTitle { color: #172033; font-size: 20px; font-weight: 750; }
QLabel#documentPanelTitle, QLabel#propertiesTitle, QLabel#previewTitle, QLabel#codeTitle, QLabel#documentInfoTitle { color: #172033; font-size: 14px; font-weight: 700; }
QLabel#documentCountLabel { padding: 3px 7px; color: #5b67f1; background: #eef0ff; border-radius: 20px; font-size: 11px; }
QLabel#selectedControlLabel { padding: 10px 11px; color: #5b67f1; background: #eef0ff; border-radius: 9px; font-size: 12px; }
QFrame#documentInfoPanel { background: transparent; border-top: 1px solid #e6eaf0; }
QListWidget { padding: 6px; color: #7c879a; background: transparent; border: none; outline: none; }
QListWidget::item { padding: 11px 10px; margin-bottom: 4px; border-radius: 9px; }
QListWidget::item:hover { color: #5b67f1; background: #eef0ff; }
QListWidget::item:selected { color: #5b67f1; background: #eef0ff; font-weight: 650; }
QTreeWidget#propertyList { color: #172033; background: transparent; border: none; outline: none; }
QTreeWidget#propertyList::item { border: none; }
QTreeWidget#propertyList::item:hover { background: #f7f8fc; }
QTreeWidget#propertyList::item:selected { background: #eef0ff; }
QFrame#previewCanvas { background: #f5f7fb; border: 1px dashed #d7dde8; border-radius: 12px; }
QScrollBar:vertical { width: 8px; margin: 2px; background: transparent; }
QScrollBar::handle:vertical { min-height: 24px; background: #c5ccda; border-radius: 4px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
animatedwidgets--FilledButton[editorControl=&quot;true&quot;] {
    min-height: 36px; min-width: 48px;
    qproperty-backgroundNormal: #5b67f1; qproperty-backgroundHover: #6975fa;
    qproperty-contentNormal: #ffffff; qproperty-cornerRadius: 9;
    qproperty-animateContentColor: true; qproperty-animationDuration: 300;
}
animatedwidgets--OutlineButton[editorControl=&quot;true&quot;] {
    min-height: 36px; min-width: 64px;
    qproperty-borderNormal: #d7dde8; qproperty-borderHover: #5b67f1;
    qproperty-contentNormal: #172033; qproperty-contentHover: #5b67f1;
    qproperty-cornerRadius: 9; qproperty-animateContentColor: true; qproperty-animationDuration: 300;
}
animatedwidgets--HoverButton[editorControl=&quot;true&quot;] {
    min-height: 38px;
    qproperty-backgroundHover: #eef0ff; qproperty-backgroundChecked: #eef0ff;
    qproperty-contentNormal: #7c879a; qproperty-contentHover: #5b67f1; qproperty-contentChecked: #5b67f1;
    qproperty-cornerRadius: 11; qproperty-animateContentColor: true; qproperty-animationDuration: 300;
}
animatedwidgets--LineEdit[editorControl=&quot;true&quot;], animatedwidgets--ComboBox[editorControl=&quot;true&quot;] {
    min-height: 34px; min-width: 48px;
    qproperty-backgroundNormal: #f5f7fb; qproperty-backgroundHover: #f5f7fb; qproperty-backgroundFocus: #f5f7fb;
    qproperty-borderNormal: #e6eaf0; qproperty-borderHover: #5b67f1; qproperty-borderFocus: #5b67f1;
    qproperty-textColor: #172033; qproperty-cornerRadius: 8; qproperty-contentPadding: 9;
}
animatedwidgets--LineEdit#documentSearchEdit {
    background: transparent; border: none;
    qproperty-borderVisible: true; qproperty-borderWidth: 1; qproperty-borderNormal: #d7dde8;
}
animatedwidgets--PlainTextEdit[editorControl=&quot;true&quot;] {
    qproperty-backgroundNormal: #171b27; qproperty-backgroundHover: #171b27; qproperty-backgroundFocus: #171b27;
    qproperty-textColor: #aebaff; qproperty-borderVisible: false; qproperty-cornerRadius: 12; qproperty-contentPadding: 15;
}
animatedwidgets--Switch[editorControl=&quot;true&quot;] {
    qproperty-checkedTrackColor: #5b67f1; qproperty-uncheckedTrackColor: #d7dde8; qproperty-animationDuration: 300;
}</string>

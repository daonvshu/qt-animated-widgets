  <property name="styleSheet">
   <string notr="true">StylePreviewPanel QScrollArea#previewScrollArea,
StylePreviewPanel QWidget#previewHost {
    background: transparent;
    border: none;
}

StylePreviewPanel animatedwidgets--LineEdit#previewWidthEdit,
StylePreviewPanel animatedwidgets--LineEdit#previewHeightEdit {
    background: transparent;
    border: none;
    qproperty-borderVisible: true;
    qproperty-borderWidth: 1;
}

StylePreviewPanel animatedwidgets--BorderedButton#previewWidthAutoButton,
StylePreviewPanel animatedwidgets--BorderedButton#previewHeightAutoButton {
    border: none;
    padding: 0px;
    min-width: 0px;
    qproperty-cornerRadius: 4;
    qproperty-borderWidth: 1;
    qproperty-animateContentColor: true;
    qproperty-animationDuration: 180;
}

StylePreviewPanel animatedwidgets--LineEdit#previewWidthEdit,
StylePreviewPanel animatedwidgets--LineEdit#previewHeightEdit,
StylePreviewPanel animatedwidgets--BorderedButton#previewWidthAutoButton,
StylePreviewPanel animatedwidgets--BorderedButton#previewHeightAutoButton,
StylePreviewPanel animatedwidgets--BorderedButton#previewBackgroundButton,
StylePreviewPanel animatedwidgets--OutlineButton#resetPreviewButton {
    min-height: 28px;
    max-height: 28px;
}

StylePreviewPanel animatedwidgets--BorderedButton#previewWidthAutoButton,
StylePreviewPanel animatedwidgets--BorderedButton#previewHeightAutoButton,
StylePreviewPanel animatedwidgets--BorderedButton#previewBackgroundButton,
StylePreviewPanel animatedwidgets--OutlineButton#resetPreviewButton {
    qproperty-cornerRadius: 4;
}

animatedwidgets--LineEdit#previewWidthEdit,
animatedwidgets--LineEdit#previewHeightEdit {
    qproperty-cornerRadius: 4;
}</string>

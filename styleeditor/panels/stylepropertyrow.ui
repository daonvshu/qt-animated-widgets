 <class>StylePropertyRow</class>
 <widget class="QWidget" name="StylePropertyRow">
  <property name="editorControl" stdset="0"><bool>true</bool></property>
  <property name="styleSheet">
   <string notr="true">QWidget#StylePropertyRow[editorControl=&quot;true&quot;] {
    background: transparent;
}

#StylePropertyRow[editorControl=&quot;true&quot;] QLabel#nameLabel[editorControl=&quot;true&quot;] {
    font-size: 11px;
    background: transparent;
}

#StylePropertyRow[editorControl=&quot;true&quot;] animatedwidgets--LineEdit[compactPropertyEditor=&quot;true&quot;][editorControl=&quot;true&quot;],
#StylePropertyRow[editorControl=&quot;true&quot;] animatedwidgets--ComboBox[compactPropertyEditor=&quot;true&quot;][editorControl=&quot;true&quot;] {
    min-height: 22px;
    max-height: 24px;
    min-width: 0px;
    font-size: 11px;
    qproperty-cornerRadius: 4;
    qproperty-contentPadding: 5;
}

#StylePropertyRow[editorControl=&quot;true&quot;] animatedwidgets--LineEdit[compactPropertyEditor=&quot;true&quot;][editorControl=&quot;true&quot;] {
    background: transparent;
    border: none;
    qproperty-borderVisible: true;
}

#StylePropertyRow[editorControl=&quot;true&quot;] animatedwidgets--SpinBox[compactPropertyEditor=&quot;true&quot;][editorControl=&quot;true&quot;] {
    min-height: 22px;
    max-height: 24px;
    min-width: 0px;
    font-size: 11px;
    qproperty-cornerRadius: 4;
    qproperty-contentPadding: 4;
    qproperty-borderVisible: true;
}

#StylePropertyRow[editorControl=&quot;true&quot;] animatedwidgets--BorderedButton#iconResourceButton[editorControl=&quot;true&quot;] {
    font-size: 11px;
    qproperty-contentHorizontalPadding: 5;
    qproperty-contentVerticalPadding: 0;
    qproperty-cornerRadius: 4;
}

#StylePropertyRow[editorControl=&quot;true&quot;] animatedwidgets--BorderedButton#colorSwatch[editorControl=&quot;true&quot;] {
    font-size: 10px;
    qproperty-borderWidth: 1;
    qproperty-cornerRadius: 4;
    qproperty-contentHorizontalPadding: 0;
    qproperty-contentVerticalPadding: 0;
}

#StylePropertyRow[editorControl=&quot;true&quot;] animatedwidgets--HoverIconButton#resetButton[editorControl=&quot;true&quot;] {
    qproperty-animateContentColor: true;
    qproperty-iconHint: true;
    qproperty-cornerRadius: 4;
}</string>

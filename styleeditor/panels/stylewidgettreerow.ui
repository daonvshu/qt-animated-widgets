   <string notr="true">QWidget#StyleWidgetTreeRow {
    background: transparent;
}

#StyleWidgetTreeRow QLabel#nameLabel {
    font-size: 12px;
    background: transparent;
}

#StyleWidgetTreeRow QLabel#detailLabel {
    font-size: 10px;
    background: transparent;
}

#StyleWidgetTreeRow animatedwidgets--HoverIconButton {
